rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','role','plan','createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.plan == 'free'
        && request.resource.data.email == request.auth.token.email;
      allow read: if isOwner(uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /resumes/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map;
      allow read, delete: if isOwner(uid) || isAdmin();
    }
    match /subscriptionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','plan','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan in ['pro','business']
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}